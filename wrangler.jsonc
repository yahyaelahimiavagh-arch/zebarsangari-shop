{
  // Cloudflare Workers: static storefront and read-only catalog API.
  "name": "zebarsangari-shop",
  "compatibility_date": "2026-10-29",
  "main": "./src/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin.html"]
  },
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "c12fd211081041eca47279fce9e341c5"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zebarsangari-db",
      "database_id": "462a80f6-4b91-4a6d-8205-7f46b7872fd0"
    }
  ]
}
